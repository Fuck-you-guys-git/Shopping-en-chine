# Copiez ce fichier en « .env » (même dossier).
# Copy this file to ".env" (same folder).

# URL du backend FastAPI, sans « /api » à la fin.
# FastAPI backend URL, without a trailing "/api".
REACT_APP_BACKEND_URL=http://localhost:8001

# Port du serveur de développement React.
# React dev-server port.
PORT=3000
