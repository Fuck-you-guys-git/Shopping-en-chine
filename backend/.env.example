# Copiez ce fichier en « .env » (même dossier) puis adaptez les valeurs.
# Copy this file to ".env" (same folder) and adjust the values.

# MongoDB — en local, installez MongoDB Community Server (le service écoute sur 27017).
# MongoDB — locally, install MongoDB Community Server (the service listens on 27017).
MONGO_URL=mongodb://localhost:27017
DB_NAME=shopping_en_chine

# Origines autorisées à appeler l'API depuis le navigateur (séparées par des virgules).
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Paxity v2 — identifiant d'organisation pour le widget de paiement (Wave, Orange Money, carte).
# Vide = paiement en ligne désactivé (seul le paiement à la livraison est proposé).
# Paxity v2 — organization id for the checkout widget. Empty disables online payment.
PAXITY_ORG_ID=

# Espace vendeur (/admin) — connexion vérifiée par le serveur. Vide = espace vendeur désactivé.
# Choisissez un mot de passe long et unique (au moins 12 caractères).
# Seller area login, checked by the server. Empty disables the seller area.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Nom affiché dans l'espace vendeur (optionnel). Display name (optional).
ADMIN_NAME=
